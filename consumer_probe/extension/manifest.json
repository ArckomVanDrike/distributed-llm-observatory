{
  "manifest_version": 3,
  "name": "Distributed LLM Observatory - Consumer Probe",
  "version": "0.1.0",
  "description": "Privacy-first local probe for measuring consumer LLM experience.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "LLM Observatory Probe",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "service_worker": "background/service_worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "consumer-probe@distributed-llm-observatory",
      "strict_min_version": "109.0"
    }
  }
}
